# Supabase
SUPA_URL=https://your-supabase-project.supabase.co
SUPA_SERVICE_ROLE_KEY=your-service-role-key

# Firebase service account (two options)
# Option A (string): JSON stringified. Escape newlines (\n) or wrap in quotes.
# FIREBASE_SERVICE_ACCOUNT_JSON='{ "type": "service_account", ... }'
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Option B (recommended): store JSON as a file and provide an absolute path to it.
# Example: FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/server/secret/firebase-key.json
FIREBASE_SERVICE_ACCOUNT_PATH=""

# Port
PORT=3000
